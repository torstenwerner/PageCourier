{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["replicaCount", "image", "serviceAccount", "app", "storage", "service", "exposure"],
	"properties": {
		"replicaCount": {
			"type": "integer",
			"minimum": 1
		},
		"image": {
			"type": "object",
			"required": ["repository", "tag", "digest", "pullPolicy", "pullSecrets"],
			"properties": {
				"repository": { "type": "string", "minLength": 1 },
				"tag": { "type": "string" },
				"digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
				"pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
				"pullSecrets": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["name"],
						"properties": { "name": { "type": "string", "minLength": 1 } }
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": { "digest": { "pattern": "^sha256:[a-f0-9]{64}$" } },
						"required": ["digest"]
					},
					"then": { "properties": { "tag": { "const": "" } } }
				},
				{
					"if": { "properties": { "digest": { "const": "" } }, "required": ["digest"] },
					"then": {
						"properties": {
							"tag": {
								"anyOf": [{ "const": "" }, { "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" }]
							}
						}
					}
				}
			]
		},
		"nameOverride": { "type": "string" },
		"fullnameOverride": { "type": "string" },
		"serviceAccount": {
			"type": "object",
			"required": ["create", "name", "automountServiceAccountToken", "annotations"],
			"properties": {
				"create": { "type": "boolean" },
				"name": { "type": "string" },
				"automountServiceAccountToken": { "type": "boolean" },
				"annotations": { "type": "object" }
			}
		},
		"podAnnotations": { "type": "object" },
		"podLabels": { "type": "object" },
		"podSecurityContext": { "type": "object" },
		"containerSecurityContext": { "type": "object" },
		"app": {
			"type": "object",
			"required": ["publicOrigin", "port", "uploadMaxBytes", "logLevel"],
			"properties": {
				"publicOrigin": { "type": "string" },
				"port": { "type": "integer", "minimum": 1, "maximum": 65535 },
				"uploadMaxBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254675455 },
				"logLevel": {
					"type": "string",
					"enum": ["trace", "debug", "info", "warn", "error", "fatal"]
				}
			}
		},
		"storage": {
			"type": "object",
			"required": ["bucket", "region", "endpoint", "forcePathStyle", "keyPrefix"],
			"properties": {
				"bucket": { "type": "string" },
				"region": { "type": "string" },
				"endpoint": { "type": "string" },
				"forcePathStyle": { "type": "boolean" },
				"keyPrefix": { "type": "string" }
			}
		},
		"extraEnv": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name"],
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"value": { "type": "string" },
					"valueFrom": { "type": "object" }
				}
			}
		},
		"extraEnvFrom": { "type": "array", "items": { "type": "object" } },
		"service": {
			"type": "object",
			"required": ["port"],
			"properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
		},
		"resources": { "type": "object" },
		"livenessProbe": { "type": "object" },
		"readinessProbe": { "type": "object" },
		"terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
		"tmpVolume": { "type": "object", "properties": { "sizeLimit": { "type": "string" } } },
		"exposure": {
			"type": "object",
			"required": ["mode", "ingress", "gateway", "istio"],
			"properties": {
				"mode": { "type": "string", "enum": ["none", "ingress", "gateway", "istio"] },
				"ingress": {
					"type": "object",
					"required": ["className", "annotations", "hosts", "tls"],
					"properties": {
						"className": { "type": "string" },
						"annotations": { "type": "object" },
						"hosts": {
							"type": "array",
							"items": {
								"type": "object",
								"required": ["host"],
								"properties": { "host": { "type": "string", "minLength": 1 } }
							}
						},
						"tls": {
							"type": "array",
							"items": {
								"type": "object",
								"required": ["hosts", "secretName"],
								"properties": {
									"hosts": { "type": "array", "items": { "type": "string" } },
									"secretName": { "type": "string", "minLength": 1 }
								}
							}
						}
					}
				},
				"gateway": {
					"type": "object",
					"required": ["parentRefs", "hostnames", "matches"],
					"properties": {
						"parentRefs": {
							"type": "array",
							"items": {
								"type": "object",
								"required": ["name"],
								"properties": { "name": { "type": "string", "minLength": 1 } }
							}
						},
						"hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
						"matches": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"headers": { "type": "array" },
									"method": { "type": "string" },
									"queryParams": { "type": "array" }
								}
							}
						}
					}
				},
				"istio": {
					"type": "object",
					"required": ["hosts", "gateways"],
					"properties": {
						"hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
						"gateways": { "type": "array", "items": { "type": "string", "minLength": 1 } }
					}
				}
			}
		}
	},
	"allOf": [
		{
			"if": { "properties": { "exposure": { "properties": { "mode": { "const": "gateway" } } } } },
			"then": {
				"properties": {
					"exposure": {
						"properties": {
							"gateway": {
								"properties": {
									"parentRefs": { "minItems": 1 }
								}
							}
						}
					}
				}
			}
		},
		{
			"if": { "properties": { "exposure": { "properties": { "mode": { "const": "istio" } } } } },
			"then": {
				"properties": {
					"exposure": {
						"properties": {
							"istio": {
								"properties": {
									"hosts": { "minItems": 1 },
									"gateways": { "minItems": 1 }
								}
							}
						}
					}
				}
			}
		},
		{
			"if": { "properties": { "exposure": { "properties": { "mode": { "const": "ingress" } } } } },
			"then": {
				"properties": {
					"exposure": {
						"properties": {
							"ingress": {
								"properties": {
									"hosts": { "minItems": 1 }
								}
							}
						}
					}
				}
			}
		}
	]
}
